 "tabledef": {
  "popupform": {
   "rolelist": {
    "*": [
     {
      "id": "firewallvm",
      "label": "{{{i18n.VMSFirewall}}}",
      "logo": "img/firewall.svg",
      "icon": "firewall"
     },
     {
      "id": "poweropvm",
      "label": "{{{i18n.VMSPowerOpVM}}}",
      "logo": "img/poweropvm.svg",
      "icon": "power"
     },
     {
      "id": "deletevm",
      "label": "{{{i18n.VMSDelete}}}",
      "logo": "img/deletevm.svg",
      "icon": "trash"
     },
     {
      "id": "resizevm",
      "label": "{{{i18n.VMSResize}}}",
      "logo": "img/resizevm.svg",
      "icon": "resize"
     }
    ]
   }
  },
  "i18nPrefix": "VMS",
  "clickrow_javascript": [
   "const data = arguments[0]; APP_CONSTANTS.ENV._vms_form_data = data;"
  ],
  "load_javascript": [
   "const vms = await $$.libapimanager.rest(APP_CONSTANTS.API_KLOUDUSTCMD, 'POST', {",
   "cmd: `listVMsForOrgOrProject \"${$$.libsession.get(APP_CONSTANTS.USERORG)}\" \"${$$.libsession.get(APP_CONSTANTS.ACTIVE_PROJECT)}\" \"${APP_CONSTANTS.VM_TYPES_SERVICES.join(',')}\"`, ",
   "project: $$.libsession.get(APP_CONSTANTS.ACTIVE_PROJECT)}, true);",
   "for (const vm of vms.vms||[]) vm.datetime = new Date(vm.timestamp).toLocaleDateString();",
   "return {keys: ['name_raw','description','vmtype','disk','cpus','memory','datetime'], table: vms.vms||[]};"
  ],
  "searchbar": true,
  "columns": [
   {
    "key": "name_raw",
    "type": "main",
    "sub": "description",
    "sortable": true
   },
   {
    "key": "vmtype",
    "type": "badge",
    "badgemap": {
     "*": "info"
    },
    "sortable": true
   },
   {
    "key": "cpus",
    "sortable": true,
    "sorttype": "num",
    "priority": 2
   },
   {
    "key": "memory",
    "sortable": true,
    "sorttype": "num",
    "priority": 2
   },
   {
    "key": "disk",
    "sortable": true,
    "sorttype": "num",
    "priority": 2
   },
   {
    "key": "datetime",
    "type": "muted",
    "sortable": true,
    "sorttype": "num",
    "sortkey": "timestamp",
    "priority": 2
   }
  ],
  "emptystate": {
   "title": "{{{i18n.CloudServicesEmptyTitle}}}",
   "message": "{{{i18n.CloudServicesEmptyMessage}}}"
  },
  "rowactions": true
 },
 "title": "{{{i18n.CloudServicesTitle}}}"
}