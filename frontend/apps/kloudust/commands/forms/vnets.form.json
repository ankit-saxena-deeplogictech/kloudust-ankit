 "tabledef": {
  "popupform": {
   "rolelist": {
    "*": [
     {
      "id": "deletevnet",
      "label": "{{{i18n.VNETSDelete}}}",
      "logo": "img/delete.svg",
      "icon": "trash"
     }
    ]
   }
  },
  "i18nPrefix": "VNETS",
  "clickrow_javascript": [
   "const data = arguments[0]; APP_CONSTANTS.ENV._vnets_form_data = data;"
  ],
  "load_javascript": [
   "const vnets = await $$.libapimanager.rest(APP_CONSTANTS.API_KLOUDUSTCMD, 'POST', {",
   "cmd: `listVnets`, ",
   "project: $$.libsession.get(APP_CONSTANTS.ACTIVE_PROJECT)}, true);",
   "return {keys: ['raw_name','description'], table: vnets.resources||[]};"
  ],
  "subtitle": "{{{i18n.VNETSSubtitle}}}",
  "pageactions": [
   {
    "id": "createvnet",
    "label": "{{{i18n.VNETSCreate}}}",
    "primary": true
   }
  ],
  "searchbar": true,
  "columns": [
   {
    "key": "raw_name",
    "type": "main",
    "sortable": true
   },
   {
    "key": "description"
   }
  ],
  "emptystate": {
   "title": "{{{i18n.VNETSEmptyTitle}}}",
   "message": "{{{i18n.VNETSEmptyMessage}}}"
