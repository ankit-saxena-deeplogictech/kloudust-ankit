 "form": {
  "description": "{{{i18n.VMCreateDescription}}}",
  "steps": [
   {
    "label": "{{{i18n.VMStepBasics}}}",
    "fields": [
     {
      "id": "vm_name",
      "type": "text",
      "placeholder": "{{{i18n.VMName}}}",
      "required": true,
      "pattern": "\\s[0-9a-zA-Z-]+\\s",
      "validation_error": "{{{i18n.FieldValidationErrorGeneric}}}"
     },
     {
      "id": "vm_description",
      "type": "text",
      "placeholder": "{{{i18n.VMDescription}}}",
      "required": true
     },
     {
      "id": "adminid",
      "type": "text",
      "placeholder": "{{{i18n.VMAdministrator}}}",
      "required": true,
      "pattern": "\\s*[A-Za-z0-9]+\\s*",
      "validation_error": "{{{i18n.FieldValidationErrorGeneric}}}"
     },
     {
      "id": "adminpass",
      "type": "password",
      "placeholder": "{{{i18n.VMAdministratorPassword}}}",
      "required": true,
      "validation_error": "{{{i18n.FieldValidationErrorGeneric}}}"
     },
     {
      "id": "vmtype",
      "type": "hidden",
      "value": "vm"
     }
    ]
   },
   {
    "label": "{{{i18n.VMStepSize}}}",
    "presets": {
     "label": "{{{i18n.VMSizePreset}}}",
     "hint": "{{{i18n.VMSizePresetHint}}}",
     "options": [
      {
       "label": "{{{i18n.VMPresetSmall}}}",
       "spec": "{{{i18n.VMPresetSmallSpec}}}",
       "values": {
        "cores": "1",
        "memory": "2048",
        "disk": "20"
       }
      },
      {
       "label": "{{{i18n.VMPresetMedium}}}",
       "spec": "{{{i18n.VMPresetMediumSpec}}}",
       "values": {
        "cores": "2",
        "memory": "4096",
        "disk": "40"
       },
       "selected": true
      },
      {
       "label": "{{{i18n.VMPresetLarge}}}",
       "spec": "{{{i18n.VMPresetLargeSpec}}}",
       "values": {
        "cores": "4",
        "memory": "8192",
        "disk": "80"
       }
      },
      {
       "label": "{{{i18n.VMPresetXLarge}}}",
       "spec": "{{{i18n.VMPresetXLargeSpec}}}",
       "values": {
        "cores": "8",
        "memory": "16384",
        "disk": "160"
       }
      }
     ]
    },
    "fields": [
     {
      "id": "cores",
      "type": "number",
      "placeholder": "{{{i18n.VMCores}}}",
      "required": true,
      "fieldrow": "size",
      "validation_error": "{{{i18n.FieldValidationErrorGeneric}}}"
     },
     {
      "id": "memory",
      "type": "number",
      "placeholder": "{{{i18n.VMMemory}}}",
      "required": true,
      "fieldrow": "size",
      "hint": "{{{i18n.VMMemoryHint}}}",
      "validation_error": "{{{i18n.FieldValidationErrorGeneric}}}"
     },
     {
      "id": "disk",
      "type": "number",
      "placeholder": "{{{i18n.VMDisk}}}",
      "required": true,
      "hint": "{{{i18n.VMDiskHint}}}",
      "validation_error": "{{{i18n.FieldValidationErrorGeneric}}}"
     },
     {
      "id": "creation_image_name",
      "multioption": true,
      "type": "select",
      "label": "{{{i18n.VMImage}}}",
      "options": []
     },
     {
      "id": "maxcores",
      "type": "number",
      "placeholder": "{{{i18n.VMMaxCores}}}",
      "fieldrow": "max",
      "validation_error": "{{{i18n.FieldValidationErrorGeneric}}}"
     },
     {
      "id": "maxmemory",
      "type": "number",
      "placeholder": "{{{i18n.VMMaxMemory}}}",
      "fieldrow": "max",
      "validation_error": "{{{i18n.FieldValidationErrorGeneric}}}"
     }
    ]
   },
   {
    "label": "{{{i18n.VMStepNetworking}}}",
    "fields": [
     {
      "id": "vnet",
      "type": "text",
      "placeholder": "{{{i18n.VMVNet}}}",
      "hint": "{{{i18n.VMVNetHint}}}"
     },
     {
      "id": "host_network",
      "type": "text",
      "placeholder": "{{{i18n.VMHostNetwork}}}"
     },
     {
      "id": "override_host",
      "type": "text",
      "placeholder": "{{{i18n.VMHostname}}}",
      "value": "",
      "pattern": "\\s[0-9a-zA-Z]+\\s",
      "validation_error": "{{{i18n.FieldValidationErrorGeneric}}}"
     }
    ]
   },
   {
    "label": "{{{i18n.VMStepAdvanced}}}",
    "fields": [
     {
      "id": "cloudinit_data",
      "inputtype": "textarea",
      "type": "text",
      "placeholder": "{{{i18n.VMCloudInitData}}}",
      "variant": "console",
      "rows": 8,
      "hint": "{{{i18n.VMCloudInitHint}}}"
     },
     {
      "id": "additional_params",
      "inputtype": "textarea",
      "type": "text",
      "placeholder": "{{{i18n.VMAdditionalParams}}}",
      "rows": 4
     },
     {
      "id": "no_qemu_agent",
      "multioption": true,
      "type": "select",
      "label": "{{{i18n.VMNoAgent}}}",
      "options": [
       {
        "value": "false",
        "label": "{{{i18n.VMNo}}}"
       },
       {
        "value": "true",
        "label": "{{{i18n.VMYes}}}"
       }
      ]
     },
     {
      "id": "force_overwrite",
      "multioption": true,
      "type": "select",
      "label": "{{{i18n.VMOverwriteForce}}}",
      "options": [
       {
        "value": "false",
        "label": "{{{i18n.VMNo}}}"
       },
       {
        "value": "true",
        "label": "{{{i18n.VMYes}}}"
       }
      ]
     }
    ]
   },
   {
    "label": "{{{i18n.VMStepReview}}}",
    "review": true
   }
  ],
  "load_javascript": [
   "const form = arguments[0]||{};",
   "const vmResult = await window.monkshu_env.frameworklibs.apimanager.rest(APP_CONSTANTS.API_KLOUDUSTCMD, ",
   "   'POST', {cmd: 'listVMImages'}, true);",
   "const imageField = form.steps[1].fields.find(field => field.id == 'creation_image_name');",
   "if (vmResult.result) for (const vm of vmResult.resources) imageField.options.push({value: vm.name, label: vm.description});",
   "if (!monkshu_env.apps[APP_CONSTANTS.APP_NAME].cmdmanager.isCloudAdminLoggedIn()) ",
   "   form.steps[2].fields = form.steps[2].fields.filter(field => !['host_network','override_host'].includes(field.id));",
   "return form;"
  ],
  "submitlabel": "{{{i18n.CreateVMSubmitLabel}}}",
  "submit_javascript": [
   "const retObject = arguments[0]||{};",
   "if (retObject.cloudinit_data && (retObject.cloudinit_data.trim() != '')) { ",
   "   LOG.info(`Not overriding existing cloudinit which is: ${retObject.cloudinit_data}`); return true; }",
   "const cloudinitTemplate = \"{system_info: {default_user: {name: \\u{007B}\\u{007B}\\u{007B}adminid\\u{007D}\\u{007D}\\u{007D}, home: /home/\\u{007B}\\u{007B}\\u{007B}adminid\\u{007D}\\u{007D}\\u{007D}, sudo: 'ALL=(ALL) NOPASSWD:ALL'}}, password: \\u{007B}\\u{007B}\\u{007B}adminpass\\u{007D}\\u{007D}\\u{007D}, chpasswd: {expire: false}, hostname: \\u{007B}\\u{007B}\\u{007B}vm_name\\u{007D}\\u{007D}\\u{007D}, ssh_pwauth: true, package_upgrade: true, packages: [net-tools, qemu-guest-agent], runcmd: [[bash, -lc, 'systemctl start qemu-guest-agent']]}\";",
   "const randomWindowsStr = (Math.random() + 1).toString(36).split(\".\")[1];",
   "const cloudinitTemplateWindows = `{hostname: \\u{007B}\\u{007B}\\u{007B}vm_name\\u{007D}\\u{007D}\\u{007D}, users: [{name: Admin, passwd: ${randomWindowsStr}, inactive: true, no_create_home: true, primary_group: Administrators}, {name: \\u{007B}\\u{007B}\\u{007B}adminid\\u{007D}\\u{007D}\\u{007D}, passwd: \\u{007B}\\u{007B}\\u{007B}adminpass\\u{007D}\\u{007D}\\u{007D}, inactive: false, primary_group: Administrators}]}`;",
   "const router = (await import(\"/framework/js/router.mjs\")).router;",
   "const mustache = await router.getMustache();",
   "const cloudInit = mustache.render(retObject.creation_image_name.toLowerCase().startsWith(\"windows\") ? ",
   "   cloudinitTemplateWindows : cloudinitTemplate, retObject);",
   "LOG.info(`Generated cloudinit is: ${cloudInit}`);",
   "retObject.cloudinit_data = cloudInit;",
   "if (retObject.override_host && retObject.override_host.trim() == '') delete retObject.override_host;",
   "return true;"
  ]
 },
 "display": "wizard"
}