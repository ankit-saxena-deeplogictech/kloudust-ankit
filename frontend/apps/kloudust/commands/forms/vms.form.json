 "tabledef": {
  "i18nPrefix": "VMS",
  "enable_copy": true,
  "pageactions": [
   {
    "label": "{{{i18n.VMSCreate}}}",
    "command": "createvm"
   }
  ],
  "clickrow_javascript": [
   "const data = arguments[0]; APP_CONSTANTS.ENV._vms_form_data = data;"
  ],
  "load_javascript": [
   "const vms = await $$.libapimanager.rest(APP_CONSTANTS.API_KLOUDUSTCMD, 'POST', {",
   "cmd: `listVMsForOrgOrProject \"${$$.libsession.get(APP_CONSTANTS.USERORG)}\" \"${$$.libsession.get(APP_CONSTANTS.ACTIVE_PROJECT)}\" \"${APP_CONSTANTS.VM_TYPE_VM}\"`, ",
   "project: $$.libsession.get(APP_CONSTANTS.ACTIVE_PROJECT)}, true);",
   "for (const vm of vms.vms||[]) {",
   "   vm.vnets_list = vm.vnets; vm.rulesets_list = vm.rulesets;",
   "   vm.datetime = new Date(vm.timestamp).toLocaleDateString(); vm.disk = parseInt(vm.disk)/1073741824; vm.memory=parseInt(vm.memory)/1048576;",
   "   vm.ips = vm.ips.trim()===''?'Not Assigned':vm.ips; vm.vnets = vm.vnets.length === 0 ?'No Vnets Found':vm.vnets.join(',');",
   "   vm.privateips = vm.private_ips.length === 0 ? 'No IPs Assigned' : vm.private_ips.join(','); ",
   "   vm.rulesets = vm.rulesets.length === 0 ? 'No Rulesets Applied' : vm.rulesets.join(',');",
   "   vm.size = `${vm.cpus} vCPU · ${vm.memory >= 1024 ? (vm.memory/1024)+' GB' : vm.memory+' MB'}`;",
   "   vm.disk_display = `${vm.disk} GB disk`;",
   "}",
   "return {keys: ['name_raw','description','ips','privateips','vnets','rulesets','os','disk','cpus','memory','datetime'], table: vms.vms||[]};"
  ],
  "clickrow_command": "vmdetail",
  "searchbar": true,
  "columns": [
   {
    "key": "name_raw",
    "type": "main",
    "sub": "description",
    "sortable": true,
    "link": true
   },
   {
    "key": "ips",
    "type": "mono",
    "sub": "privateips",
    "subtype": "mono"
   },
   {
    "key": "vnets",
    "priority": 2
   },
   {
    "key": "size",
    "sub": "disk_display",
    "sortable": true,
    "sorttype": "num",
    "sortkey": "cpus",
    "priority": 2
   },
   {
    "key": "os",
    "type": "muted",
    "sortable": true,
    "priority": 3
   },
   {
    "key": "hostname",
    "type": "muted",
    "sortable": true,
    "priority": 3
   },
   {
    "key": "datetime",
    "type": "muted",
    "sortable": true,
    "sorttype": "num",
    "sortkey": "timestamp",
    "priority": 2
   }
  ],
  "emptystate": {
   "title": "{{{i18n.VMSEmptyTitle}}}",
   "message": "{{{i18n.VMSEmptyMessage}}}"
  },
  "selectable": true,
  "filterkey": "hostname",
  "pagesize": 25,
  "bulkactions": [
   {
    "label": "{{{i18n.VMSBulkStart}}}",
    "command": "powerOpVM",
    "args": [
     {
      "key": "name_raw"
     },
     {
      "const": "start"
     }
    ]
   },
   {
    "label": "{{{i18n.VMSBulkStop}}}",
    "command": "powerOpVM",
    "args": [
     {
      "key": "name_raw"
     },
     {
      "const": "stop"
     }
    ]
   },
   {
    "label": "{{{i18n.VMSBulkDelete}}}",
    "command": "deleteVM",
    "args": [
     {
      "key": "name_raw"
     }
    ],
    "danger": true,
    "confirm": "{{{i18n.VMSBulkDeleteConfirm}}}"
   }
  ],
  "popupform": {
   "rolelist": {
    "*": [
     {
      "id": "poweropvm",
      "label": "{{{i18n.VMSPowerOpVM}}}",
      "logo": "img/poweropvm.svg"
     },
     {
      "id": "snapshotvm",
      "label": "{{{i18n.VMSSnapshot}}}",
      "logo": "img/snapshot.svg"
     },
     {
      "id": "resizevm",
      "label": "{{{i18n.VMSResize}}}",
      "logo": "img/resizevm.svg"
     },
     {
      "id": "clonevm",
      "label": "{{{i18n.VMSClone}}}",
      "logo": "img/clonevm.svg"
     },
     {
      "id": "firewallvm",
      "label": "{{{i18n.VMSFirewall}}}",
      "logo": "img/firewall.svg"
     },
     {
      "id": "deletevm",
      "label": "{{{i18n.VMSDelete}}}",
      "logo": "img/deletevm.svg"
     }
    ]
   }
  },
  "rowactions": true
 },
 "title": "{{{i18n.VMSTitle}}}"
