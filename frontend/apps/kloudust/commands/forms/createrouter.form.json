{
 "id": "createrouter",
 "command": "createOrUpdateRouter",
 "type": "kloudust_cmdline",
 "kloudust_cmdline_params": [
  "router_name",
  "router_description",
  "router_settings"
 ],
 "title": "{{{i18n.RouterTitle}}}",
 "i18n": {
  "en": {
   "RouterTitle": "Create Router",
   "RouterDescription": "Create a Router.",
   "RouterDescriptionField": "Description",
   "RouterName": "Name",
   "FieldValidationErrorGeneric": "Validation error",
   "RouterCreateLabel": "Create"
  },
  "hi": {
   "RouterTitle": "Create Router",
   "RouterDescription": "Create a Router.",
   "RouterDescriptionField": "Description",
   "RouterName": "नाम",
   "FieldValidationErrorGeneric": "Validation error",
   "RouterCreateLabel": "Create"
  },
  "ja": {
   "RouterTitle": "Create Router",
   "RouterDescription": "Create a Router.",
   "RouterDescriptionField": "Description",
   "RouterName": "名",
   "FieldValidationErrorGeneric": "Validation error",
   "RouterCreateLabel": "Create"
  },
  "zh": {
   "RouterTitle": "Create Router",
   "RouterDescription": "Create a Router.",
   "RouterDescriptionField": "Description",
   "RouterName": "姓名",
   "FieldValidationErrorGeneric": "Validation error",
   "RouterCreateLabel": "Create"
  }
 },
 "form": {
  "description": "{{{i18n.RouterDescription}}}",
  "required_label": "{{{i18n.Required}}}",
  "required_fields": [
   {
    "id": "router_name",
    "type": "text",
    "placeholder": "{{{i18n.RouterName}}}",
    "required": true,
    "pattern": "[0-9a-zA-Z]+",
    "validation_error": "{{{i18n.FieldValidationErrorGeneric}}}"
   },
   {
    "id": "router_description",
    "type": "text",
    "placeholder": "{{{i18n.RouterDescriptionField}}}"
   },
   {
    "id": "router_settings",
    "type": "hidden",
    "value": "[]"
   },
   {
    "id": "routerVnetsComponent",
    "inputtype": "vnet-ip"
   }
  ],
  "submitlabel": "{{{i18n.RouterCreateLabel}}}",
  "submit_javascript": [
   "const form = arguments[1], shadowroot = form._form_shadowroot;",
   "const retObject = arguments[0]||{};",
   "retObject.router_settings = JSON.stringify(shadowroot.querySelector('vnet-ip').value);",
   "return true;"
  ],
  "load_javascript": [
   "const form = arguments[0] || {};",
   "const vnets = await $$.libapimanager.rest(APP_CONSTANTS.API_KLOUDUSTCMD, 'POST', {",
   "cmd: `listVnets`, ",
   "project: $$.libsession.get(APP_CONSTANTS.ACTIVE_PROJECT)}, true);",
   "// listVnets can come back empty or fail outright (role, network). Find the",
   "// field by id rather than by position, and default to an empty vnet list, so",
   "// the form still renders instead of throwing out of elementConnected.",
   "const vnetField = form.required_fields.find(field => field.id == 'routerVnetsComponent');",
   "const names = (vnets && Array.isArray(vnets.resources) ? vnets.resources : [])",
   "   .map(vnet => vnet.raw_name).filter(name => name && !name.includes('backbone'));",
   "if (vnetField) vnetField.value = JSON.stringify({vnets: names});",
   "else LOG.error('routerVnetsComponent field missing from the router form');",
   "return form;"
  ],
  "layout": "wide"
 }
}