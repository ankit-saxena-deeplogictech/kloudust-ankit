 "tabledef": {
  "i18nPrefix": "IPA",
  "enable_copy": true,
  "subtitle": "{{{i18n.IPAssignSubtitle}}}",
  "pageactions": [
   {
    "id": "addip",
    "label": "{{{i18n.IPAssignAdd}}}",
    "primary": true,
    "icon": "plus"
   },
   {
    "id": "assignipvm",
    "label": "{{{i18n.IPAssignAssignAuto}}}",
    "icon": "ip"
   }
  ],
  "searchbar": true,
  "filterkey": "state",
  "pagesize": 25,
  "rowactions": true,
  "popupform": {
   "rolelist": {
    "*": [
     {
      "id": "unassignipvm",
      "label": "{{{i18n.IPAssignUnassign}}}",
      "logo": "img/removeuser.png",
      "icon": "ip"
     }
    ]
   }
  },
  "clickrow_javascript": [
   "const data = arguments[0]; APP_CONSTANTS.ENV._ip_form_data = data;"
  ],
  "load_javascript": [
   "const result = await $$.libapimanager.rest(APP_CONSTANTS.API_KLOUDUSTCMD, 'POST', ",
   "   {cmd: 'listIPs', project: $$.libsession.get(APP_CONSTANTS.ACTIVE_PROJECT)}, true);",
   "const org = $$.libsession.get(APP_CONSTANTS.USERORG), project = $$.libsession.get(APP_CONSTANTS.ACTIVE_PROJECT);",
   "// allocatedto is '' when free, the literal 'reserved' for network/gateway/",
   "// broadcast, and otherwise the resolved resource name (raw_org_project).",
   "const suffix = `_${org}_${project}`.toLowerCase();",
   "const ips = (result?.ips)||[];",
   "for (const entry of ips) {",
   "   const held = (entry.allocatedto||'').trim();",
   "   entry.state = held === '' ? '{{{i18n.IPStateFree}}}' : held.toLowerCase() === 'reserved' ",
   "      ? '{{{i18n.IPStateReserved}}}' : '{{{i18n.IPStateAssigned}}}';",
   "   entry.attachedto = (held === '' || held.toLowerCase() === 'reserved') ? '' : ",
   "      (held.toLowerCase().endsWith(suffix) ? held.substring(0, held.length - suffix.length) : held);",
   "   entry.since = entry.timestamp ? new Date(parseInt(entry.timestamp)).toLocaleDateString() : '';",
   "}",
   "return {keys: ['ip','state','attachedto','hostname','since'], table: ips};"
  ],
  "columns": [
   {
    "key": "ip",
    "type": "main",
    "sortable": true
   },
   {
    "key": "state",
    "type": "badge",
    "sortable": true,
    "badgemap": {
     "free": "success",
     "reserved": "warning",
     "assigned": "info",
     "*": "neutral"
    }
   },
   {
    "key": "attachedto",
    "type": "mono"
   },
   {
    "key": "hostname",
    "type": "muted",
    "sortable": true
   },
   {
    "key": "since",
    "type": "muted",
    "sortable": true,
    "sorttype": "num",
    "sortkey": "timestamp",
    "priority": 2
   }
  ],
  "emptystate": {
   "title": "{{{i18n.IPAssignEmptyTitle}}}",
   "message": "{{{i18n.IPAssignEmptyMessage}}}"
  }
 }
}