   "ProjectsAddUserToProject": "Add User",
   "ProjectsRemoveUserFromProject": "Remove User",
   "ProjectsDeleteProject": "Delete Project",
   "ProjectsTitle": "Projects",
   "ProjectsEmptyTitle": "No projects yet",
   "ProjectsEmptyMessage": "Add a project to organize your cloud resources."
  },
  "ja": {
   "Projects_name": "Name",
