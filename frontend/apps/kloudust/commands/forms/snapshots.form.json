 "tabledef": {
  "popupform": {
   "rolelist": {
    "*": [
     {
      "id": "restoresnapshot",
      "label": "{{{i18n.SNAPSHOTSRestore}}}",
      "logo": "img/restore.svg",
      "icon": "reboot"
     },
     {
      "id": "deletesnapshot",
      "label": "{{{i18n.SNAPSHOTSDelete}}}",
      "logo": "img/delete.svg",
      "icon": "trash"
     }
    ]
   }
  },
  "i18nPrefix": "SNAPSHOTS",
  "clickrow_javascript": [
   "const data = arguments[0]; APP_CONSTANTS.ENV._snapshots_form_data = data;"
  ],
  "load_javascript": [
   "let snapshots = await $$.libapimanager.rest(APP_CONSTANTS.API_KLOUDUSTCMD, 'POST', {",
   "cmd: `listSnapshots`, ",
   "project: $$.libsession.get(APP_CONSTANTS.ACTIVE_PROJECT)}, true);",
   "// listSnapshots derives its vm field by cutting the org out of the stored id, which comes back",
   "// empty whenever the org name holds a space. The VM list carries the display name already, so",
   "// the snapshot is matched to its machine on the id both sides agree on.",
   "const vms = await $$.libapimanager.rest(APP_CONSTANTS.API_KLOUDUSTCMD, 'POST', {",
   "cmd: `listVMsForOrgOrProject \"${$$.libsession.get(APP_CONSTANTS.USERORG)}\" \"${$$.libsession.get(APP_CONSTANTS.ACTIVE_PROJECT)}\" \"${APP_CONSTANTS.VM_TYPE_VM}\"`, ",
   "project: $$.libsession.get(APP_CONSTANTS.ACTIVE_PROJECT)}, true);",
   "const vmNames = {}; for (const vm of vms.vms||[]) vmNames[vm.name] = vm.name_raw;",
   "snapshots = (snapshots.snapshots||[]).map(snapshotObj => ({ ...snapshotObj,",
   "   vm: vmNames[snapshotObj.resourceid] || snapshotObj.vm || snapshotObj.resourceid,",
   "   localtime: new Date(snapshotObj.timestamp).toLocaleString() }));",
   "return {keys: ['name','vm','localtime'], table: snapshots};"
  ],
  "subtitle": "{{{i18n.SNAPSHOTSSubtitle}}}",
  "searchbar": true,
  "columns": [
   {
    "key": "name",
    "type": "main",
    "sortable": true
   },
   {
    "key": "vm",
    "sortable": true
   },
   {
    "key": "localtime",
    "type": "muted",
    "sortable": true,
    "sorttype": "num",
    "sortkey": "timestamp"
   }
  ],
  "emptystate": {
   "title": "{{{i18n.SNAPSHOTSEmptyTitle}}}",
   "message": "{{{i18n.SNAPSHOTSEmptyMessage}}}"
  },
  "rowactions": true
 },
 "title": "{{{i18n.SNAPSHOTSTitle}}}"
}
