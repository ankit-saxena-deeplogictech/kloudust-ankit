     "label": "{{{i18n.ImagesDelete}}}",
     "danger": true
    }
   ]
  },
  "subtitle": "{{{i18n.ImagesSubtitle}}}",
  "pageactions": [
   {
    "id": "addimage",
    "label": "{{{i18n.ImagesAdd}}}",
    "primary": true
   }
  ],
  "searchbar": true,
  "filterkey": "processorarchitecture",
  "countlabel": "{{{i18n.ImagesCount}}}",
  "clickrow_javascript": [
   "const data = arguments[0]; APP_CONSTANTS.ENV._images_form_data = data;"
  ],
  "load_javascript": [
   "const imagesResult = await $$.libapimanager.rest(APP_CONSTANTS.API_KLOUDUSTCMD, 'POST', ",
   "   {cmd: 'listVMImages', project: $$.libsession.get(APP_CONSTANTS.ACTIVE_PROJECT)}, true);",
   "const images = imagesResult?.resources||[];",
   "const vmsResult = await $$.libapimanager.rest(APP_CONSTANTS.API_KLOUDUSTCMD, 'POST', {",
   "   cmd: `listVMsForOrgOrProject \"${$$.libsession.get(APP_CONSTANTS.USERORG)}\" \"${$$.libsession.get(APP_CONSTANTS.ACTIVE_PROJECT)}\" \"${APP_CONSTANTS.VM_TYPE_VM}\"`,",
   "   project: $$.libsession.get(APP_CONSTANTS.ACTIVE_PROJECT)}, true);",
   "const vms = vmsResult?.vms||[];",
   "for (const image of images) {",
   "   const splits = (image.extrainfo||'').split(':');",
   "   image.osvariant = (splits[0]||'').trim();",
   "   image.format = (splits[1]||'').trim();",
   "   const users = image.osvariant ? vms.filter(vm => vm.os == image.osvariant).length : 0;",
   "   image.usedby = users == 1 ? '1 VM' : `${users} VMs`;",
   "   image.added = image.timestamp ? new Date(parseInt(image.timestamp)).toLocaleDateString() : '';",
   "   image.source = (image.uri||'').split('/').pop();",
   "}",
   "return {table: images};"
  ],
  "emptystate": {
   "title": "{{{i18n.ImagesEmptyTitle}}}",
   "message": "{{{i18n.ImagesEmptyMessage}}}"
  }
 }
}