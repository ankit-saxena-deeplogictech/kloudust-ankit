 },
 "tabledef": {
  "i18nPrefix": "HOSTS",
  "searchbar": true,
  "enable_copy": true,
  "popupform": {
   "rolelist": {
    "*": [
     {
      "id": "hostdetail",
      "label": "{{{i18n.HostsView}}}",
      "logo": "img/monitor.svg"
     },
     {
      "id": "reboothost",
      "label": "{{{i18n.HostsReboot}}}",
      "logo": "img/poweropvm.svg"
     },
     {
      "id": "deletehost",
      "label": "{{{i18n.HostsDelete}}}",
      "logo": "img/delete.svg"
     }
    ]
   }
  },
  "columns": [
   {
    "key": "hostname",
    "type": "main",
    "sub": "hostaddress",
    "subtype": "mono",
    "sortable": true,
    "link": true
   },
   {
    "key": "type",
    "type": "badge",
    "badgemap": {
     "*": "neutral"
    }
   },
   {
    "key": "vmcount",
    "sortable": true,
    "sorttype": "num"
   },
   {
    "key": "cores",
    "sortable": true,
    "sorttype": "num"
   },
   {
    "key": "memory_display",
    "sortable": true,
    "sorttype": "num",
    "sortkey": "memory"
   },
   {
    "key": "disk_display",
    "sortable": true,
    "sorttype": "num",
    "sortkey": "disk",
    "priority": 2
   },
   {
    "key": "processorarchitecture",
    "type": "muted",
    "priority": 3
   }
  ],
  "emptystate": {
   "title": "{{{i18n.HostsEmptyTitle}}}",
   "message": "{{{i18n.HostsEmptyMessage}}}"
  },
  "clickrow_javascript": [
   "const data = arguments[0]; APP_CONSTANTS.ENV._hosts_form_data = data;"
  ],
  "clickrow_command": "hostdetail",
  "load_javascript": [
   "const hostsResult = await $$.libapimanager.rest(APP_CONSTANTS.API_KLOUDUSTCMD, 'POST', {cmd: 'listHosts'}, true);",
   "const hosts = hostsResult?.resources||[];",
   "const vmsResult = await $$.libapimanager.rest(APP_CONSTANTS.API_KLOUDUSTCMD, 'POST', {",
   "  cmd: `listVMsForOrgOrProject \"${$$.libsession.get(APP_CONSTANTS.USERORG)}\" \"${$$.libsession.get(APP_CONSTANTS.ACTIVE_PROJECT)}\" \"${APP_CONSTANTS.VM_TYPE_VM}\"`,",
   "  project: $$.libsession.get(APP_CONSTANTS.ACTIVE_PROJECT)}, true);",
   "const gb = bytes => {const g = (parseInt(bytes)||0)/1073741824; return g >= 1024 ? (g/1024).toFixed(1)+' TB' : Math.round(g)+' GB';};",
   "for (const host of hosts) {",
   "  host.memory_display = gb(host.memory); host.disk_display = gb(host.disk);",
   "  host.vmcount = (vmsResult?.vms||[]).filter(vm => vm.hostname == host.hostname).length;",
   "}",
   "return {keys: ['hostname','hostaddress','type','vmcount','cores','memory_display','disk_display','processorarchitecture'], table: hosts};"
  ],
  "filterkey": "type",
  "pagesize": 25,
  "rowactions": true
 }
}