 "tabledef": {
  "popupform": {
   "rolelist": {
    "*": [
     {
      "id": "viewfirewallruleset",
      "label": "{{{i18n.RULESETView}}}",
      "logo": "img/view.png",
      "icon": "eye"
     },
     {
      "id": "editfirewallruleset",
      "label": "{{{i18n.RULESETEdit}}}",
      "logo": "img/edit.png",
      "icon": "edit"
     },
     {
      "id": "deletefirewallruleset",
      "label": "{{{i18n.RULESETDelete}}}",
      "logo": "img/delete.svg",
      "icon": "trash"
     }
    ]
   }
  },
  "i18nPrefix": "RULESET",
  "clickrow_javascript": [
   "const data = arguments[0]; APP_CONSTANTS.ENV._firewallruleset_form_data = data;"
  ],
  "load_javascript": [
   "const firewallRulesets = await $$.libapimanager.rest(APP_CONSTANTS.API_KLOUDUSTCMD, 'POST', {",
   "cmd: `listFirewallRulesets`, ",
   "project: $$.libsession.get(APP_CONSTANTS.ACTIVE_PROJECT)}, true);",
   "for (const ruleset of firewallRulesets.rulesets||[]) {ruleset.created_ts = new Date(ruleset.created_at).getTime(); ruleset.created_at = new Date(ruleset.created_at).toLocaleDateString();}",
   "return {keys: ['name','description','created_at'], table: firewallRulesets.rulesets||[]};"
  ],
  "subtitle": "{{{i18n.RULESETSubtitle}}}",
  "pageactions": [
   {
    "id": "createfirewall",
    "label": "{{{i18n.RULESETCreate}}}",
    "primary": true
   }
  ],
  "searchbar": true,
  "columns": [
   {
    "key": "name",
    "type": "main",
    "sub": "description",
    "sortable": true
   },
   {
    "key": "created_at",
    "type": "muted",
    "sortable": true,
    "sorttype": "num",
    "sortkey": "created_ts",
    "priority": 2
   }
  ],
  "emptystate": {
   "title": "{{{i18n.RULESETEmptyTitle}}}",
   "message": "{{{i18n.RULESETEmptyMessage}}}"
  },
  "rowactions": true
 },
 "title": "{{{i18n.RULESETTitle}}}"
}