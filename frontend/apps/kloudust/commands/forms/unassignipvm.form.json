   "IPUnassignVM": "Machine holding the address",
   "IPUnassignIP": "Address",
   "IPUnassignSubmit": "Unassign",
   "FieldValidationErrorGeneric": "Validation error",
   "Required": "Required"
  },
  "hi": {
   "IPUnassignTitle": "Unassign address",
