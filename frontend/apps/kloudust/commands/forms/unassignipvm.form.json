{
 "id": "unassignipvm",
 "command": "unassignIPToVM",
 "type": "kloudust_cmdline",
 "presentation": "drawer",
 "kloudust_cmdline_params": [
  "vm_name",
  "ip",
  "vnetlist"
 ],
 "title": "{{{i18n.IPUnassignTitle}}}",
 "i18n": {
  "en": {
