   "IPUnassignIP": "Address",
   "IPUnassignSubmit": "Unassign",
   "FieldValidationErrorGeneric": "Validation error",
   "Required": "Required"
  },
  "ja": {
   "IPUnassignTitle": "Unassign address",
   "IPUnassignDescription": "Removes this public address from the machine holding it and returns it to the free pool. The machine keeps running but loses its public address.",
   "IPUnassignVM": "Machine holding the address",
   "IPUnassignIP": "Address",
   "IPUnassignSubmit": "Unassign",
