 },
 "tabledef": {
  "popupform": {
   "rolelist": {
    "*": [
     {
      "id": "editrouter",
      "label": "{{{i18n.RoutersEdit}}}",
      "logo": "img/edit.png"
     },
     {
      "id": "deleterouter",
      "label": "{{{i18n.RoutersDelete}}}",
      "logo": "img/delete.svg"
     }
    ]
   }
  },
  "i18nPrefix": "Routers",
  "enable_copy": true,
  "clickrow_javascript": [
   "const data = arguments[0]; APP_CONSTANTS.ENV._routers_form_data = data;"
  ],
  "load_javascript": [
   "const routers = await $$.libapimanager.rest(APP_CONSTANTS.API_KLOUDUSTCMD, 'POST', {",
   "cmd: `listRouters \"${$$.libsession.get(APP_CONSTANTS.USERORG)}\" \"${$$.libsession.get(APP_CONSTANTS.ACTIVE_PROJECT)}\"`, ",
   "project: $$.libsession.get(APP_CONSTANTS.ACTIVE_PROJECT)}, true);",
   "for (const router of routers.routers||[]) {",
   "   router.datetime = new Date(router.timestamp).toLocaleDateString();",
   "   router.ips = router.vnet_ips.length === 0 ? 'No IPs Assigned' : router.vnet_ips.map(vi=>vi.ip).join(','); ",
   "   router.vnets = router.vnet_ips.length === 0 ? 'No Vnet Found' : router.vnet_ips.map(vi=>vi.vnet).join(','); ",
   "}",
   "return {keys: ['name_raw','description','vnets','ips','datetime'], table: routers.routers||[]};"
  ],
  "searchbar": true,
  "columns": [
   {
    "key": "name_raw",
    "type": "main",
    "sub": "description",
    "sortable": true
   },
   {
    "key": "vnets"
   },
   {
    "key": "ips",
    "type": "mono"
   },
   {
    "key": "datetime",
    "type": "muted",
    "sortable": true,
    "sorttype": "num",
    "sortkey": "timestamp",
    "priority": 2
   }
  ],
  "emptystate": {
   "title": "{{{i18n.RoutersEmptyTitle}}}",
   "message": "{{{i18n.RoutersEmptyMessage}}}"
  },
  "rowactions": true
 },
 "title": "{{{i18n.RoutersTitle}}}"
}